{
  "name": "lattice",
  "version": "1.0.0",
  "private": true,
  "description": "A real-time collaborative whiteboard built from scratch on the CRDT paper (Shapiro et al., 2011). Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-site.mjs",
    "test": "tsc -p tsconfig.json && node --test build/test/*.test.js",
    "test:long": "tsc -p tsconfig.json && SEEDS=3000 node --test build/test/*.test.js",
    "dev": "npm run build && node scripts/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~6.0.3"
  }
}
